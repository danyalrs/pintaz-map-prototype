{
  "name": "pintaz-map-prototype",
  "version": "0.1.0",
  "description": "Miniature Pintaz Map prototype — Mapbox basemap + local OSM road vector tiles",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "download:osm": "node scripts/download-osm.js",
    "verify:osm": "node scripts/verify-osm.js",
    "extract:roads": "node scripts/extract-roads.js",
    "build:tiles": "node scripts/build-road-tiles.js",
    "validate:data": "node scripts/validate-road-data.js",
    "scan:coverage": "node scripts/scan-road-tile-coverage.js",
    "extract:2km": "node scripts/extract-2km-bandar-kinrara.js",
    "extract:2km:bukit": "node scripts/extract-2km-local-area.js bukit-bintang-imbi",
    "test": "node --test tests",
    "test:public": "node scripts/run-public-tests.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "osm-pbf-parser": "^2.3.0",
    "sql.js": "^1.14.2",
    "through2": "^4.0.2",
    "@mapbox/vector-tile": "^1.3.1",
    "pbf": "^3.2.1"
  }
}
